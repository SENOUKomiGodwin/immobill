// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums en français pour compatibilité avec le front
// Note: Prisma requires ASCII for enum values, mapped in DTOs
enum PropertyType {
  IMMEUBLE
  MAISON
  RESIDENCE
  BOUTIQUE
  TERRAIN
}

enum UnitType {
  APPARTEMENT
  STUDIO
  CHAMBRE
  BOUTIQUE
  AUTRE
}

enum UnitStatus {
  LIBRE
  OCCUPE
}

enum LeaseStatus {
  ACTIF
  TERMINE
}

enum RentDueStatus {
  ATTENTE
  PARTIEL
  PAYE
  RETARD
  ANNULE
}

enum RentDueComputedStatus {
  paid
  partial
  late
  pending
}

enum PaymentMethod {
  ESPACES
  MOBILE_MONEY
  VIREMENT
  CHEQUE
}

enum ExpenseCategory {
  PLOMBERIE
  PEINTURE
  ELECTRICITE
  TAXES
  ASSURANCE
  GARDIENNAGE
  REPARATION
  AUTRE
}

enum UserRole {
  admin
  user
}

// Compteur pour numérotation des quittances (Q-AAAA-NNNN)
model owner_counters {
  id          String   @id @default(uuid())
  owner_id    String
  year        Int
  sequence    Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([owner_id, year])
  @@index([owner_id])
  @@map("owner_counters")
}

// Journal d'audit
model audit_log {
  id          String   @id @default(uuid())
  user_id     String
  user_name   String
  action      String
  entity_type String
  entity_id   String
  before      Json?
  after       Json?
  reason      String?
  created_at  DateTime @default(now())

  @@index([entity_type, entity_id])
  @@index([user_id])
  @@index([created_at])
  @@map("audit_log")
}

// Refresh tokens pour JWT
model refresh_tokens {
  id           String   @id @default(uuid())
  user_id      String
  token        String   @unique
  expires_at   DateTime
  created_at   DateTime @default(now())
  revoked_at   DateTime?

  @@index([user_id])
  @@index([token])
  @@map("refresh_tokens")
}

// Relances envoyées
model Reminder {
  id          String   @id @default(uuid())
  due_id      String
  tier        Int      // 1 = J+1, 7 = J+7, 15 = J+15
  method      String
  message     String?
  sent_at     DateTime @default(now())
  created_by_id String

  rent_due    RentDue  @relation(fields: [due_id], references: [id], onDelete: Cascade)

  @@unique([due_id, tier])
  @@index([due_id])
  @@index([created_by_id])
  @@map("reminders")
}

// User
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password_hash String
  full_name    String?
  role         UserRole   @default(user)
  created_date DateTime  @default(now())
  updated_date DateTime  @updatedAt
  created_by_id String

  @@index([email])
  @@index([created_by_id])
  @@map("users")
}

// Property
model Property {
  id           String       @id @default(uuid())
  name         String
  type         PropertyType @default(IMMEUBLE)
  address      String?
  city         String?
  notes        String?
  created_date DateTime     @default(now())
  updated_date DateTime     @updatedAt
  created_by_id String

  units        Unit[]

  @@index([created_by_id])
  @@map("properties")
}

// Unit
model Unit {
  id            String     @id @default(uuid())
  property_id   String
  label         String
  type          UnitType   @default(APPARTEMENT)
  surface       Int?
  rent_amount   Int?
  charges_amount Int?
  status        UnitStatus @default(LIBRE)
  created_date  DateTime   @default(now())
  updated_date  DateTime   @updatedAt
  created_by_id String

  property      Property   @relation(fields: [property_id], references: [id], onDelete: Cascade)
  leases        Lease[]

  // @@unique([property_id, status]) where: status = 'Occupé' // Partial unique index added via migration
  @@index([property_id])
  @@index([created_by_id])
  @@map("units")
}

// Tenant
model Tenant {
  id             String    @id @default(uuid())
  full_name      String
  phone          String?
  email          String?
  id_number      String?
  city           String?
  rent_amount    Int?
  advance_amount Int?
  advance_months Int?
  notes          String?
  created_date   DateTime  @default(now())
  updated_date   DateTime  @updatedAt
  created_by_id  String

  leases         Lease[]

  @@index([created_by_id])
  @@map("tenants")
}

// Lease
model Lease {
  id              String      @id @default(uuid())
  unit_id         String
  unit_label      String?
  property_id     String?
  property_name   String?
  tenant_id       String
  tenant_name     String?
  tenant_phone    String?
  start_date      DateTime
  end_date        DateTime?
  rent_amount     Int?
  charges_amount  Int?
  deposit_amount  Int?
  due_day         Int         @default(5)
  grace_days      Int         @default(0)
  penalty_enabled Boolean     @default(false)
  status          LeaseStatus @default(ACTIF)
  notes           String?
  created_date    DateTime    @default(now())
  updated_date    DateTime    @updatedAt
  created_by_id   String

  unit            Unit        @relation(fields: [unit_id], references: [id], onDelete: Cascade)
  tenant          Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  rent_dues       RentDue[]

  @@index([unit_id])
  @@index([tenant_id])
  @@index([status])
  @@index([created_by_id])
  @@map("leases")
}

// RentDue
model RentDue {
  id              String                @id @default(uuid())
  lease_id        String
  tenant_id       String?
  tenant_name     String?
  tenant_phone    String?
  unit_id         String?
  unit_label      String?
  property_id     String?
  property_name   String?
  period          String                // YYYY-MM
  due_date        DateTime
  amount_due      Int
  amount_paid     Int                   @default(0)
  status          RentDueStatus         @default(ATTENTE)
  computed_status RentDueComputedStatus?
  days_late       Int?
  created_date    DateTime              @default(now())
  updated_date    DateTime              @updatedAt
  created_by_id   String

  lease           Lease                 @relation(fields: [lease_id], references: [id], onDelete: Cascade)
  payments        Payment[]
  reminders       Reminder[]

  @@unique([lease_id, period])
  @@index([lease_id])
  @@index([period])
  @@index([created_by_id])
  @@map("rent_dues")
}

// Payment
model Payment {
  id                  String         @id @default(uuid())
  due_id              String
  lease_id            String?
  tenant_id           String?
  tenant_name         String?
  unit_label          String?
  property_name       String?
  period              String?        // YYYY-MM
  amount              Int
  payment_date        DateTime
  method              PaymentMethod  @default(ESPACES)
  reference           String?
  receipt_number      String?
  note                String?
  cancelled           Boolean        @default(false)
  cancellation_reason String?
  created_date        DateTime       @default(now())
  updated_date        DateTime       @updatedAt
  created_by_id       String

  rent_due             RentDue        @relation(fields: [due_id], references: [id], onDelete: Cascade)

  @@index([due_id])
  @@index([lease_id])
  @@index([payment_date])
  @@index([created_by_id])
  // @@unique([receipt_number]) where: receipt_number != null // Partial unique index added via migration
  @@map("payments")
}

// Expense
model Expense {
  id                String          @id @default(uuid())
  property_id       String?
  property_name     String?
  label             String
  category          ExpenseCategory @default(AUTRE)
  vendor            String?
  amount            Int
  expense_date      DateTime
  paid              Boolean         @default(true)
  refacture         Boolean         @default(false)
  recovered_amount  Int             @default(0)
  receipt_uri       String?
  note              String?
  cancelled         Boolean         @default(false)
  cancellation_reason String?
  created_date      DateTime        @default(now())
  updated_date      DateTime        @updatedAt
  created_by_id     String

  @@index([property_id])
  @@index([expense_date])
  @@index([created_by_id])
  @@map("expenses")
}

// File metadata
model File {
  id                String   @id @default(uuid())
  file_key          String   @unique
  filename          String
  content_type      String
  size              Int
  bucket            String
  related_entity_type String?
  related_entity_id   String?
  created_date      DateTime @default(now())
  created_by_id     String

  @@index([created_by_id])
  @@index([related_entity_type, related_entity_id])
  @@map("files")
}
