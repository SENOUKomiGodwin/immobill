{
  "name": "Property",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nom du bien"
    },
    "type": {
      "type": "string",
      "title": "Type de bien",
      "enum": [
        "Immeuble",
        "Maison",
        "R\u00e9sidence",
        "Boutique",
        "Terrain"
      ],
      "default": "Immeuble"
    },
    "address": {
      "type": "string",
      "title": "Adresse"
    },
    "city": {
      "type": "string",
      "title": "Ville"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}