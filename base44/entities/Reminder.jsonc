{
  "name": "Reminder",
  "type": "object",
  "properties": {
    "due_id": {
      "type": "string",
      "title": "Échéance"
    },
    "tier": {
      "type": "number",
      "title": "Palier",
      "description": "1 = J+1, 7 = J+7, 15 = J+15"
    },
    "method": {
      "type": "string",
      "title": "Méthode",
      "enum": [
        "whatsapp",
        "sms",
        "email",
        "autre"
      ]
    },
    "message": {
      "type": "string",
      "title": "Message"
    }
  },
  "required": [
    "due_id",
    "tier",
    "method"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
