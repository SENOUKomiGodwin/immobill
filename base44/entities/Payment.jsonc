{
  "name": "Payment",
  "type": "object",
  "properties": {
    "due_id": {
      "type": "string",
      "title": "\u00c9ch\u00e9ance"
    },
    "lease_id": {
      "type": "string",
      "title": "Bail"
    },
    "tenant_id": {
      "type": "string",
      "title": "Locataire"
    },
    "tenant_name": {
      "type": "string",
      "title": "Locataire (nom)"
    },
    "unit_label": {
      "type": "string",
      "title": "Unit\u00e9 (libell\u00e9)"
    },
    "property_name": {
      "type": "string",
      "title": "Bien (nom)"
    },
    "period": {
      "type": "string",
      "title": "P\u00e9riode (AAAA-MM)"
    },
    "amount": {
      "type": "number",
      "title": "Montant (FCFA)"
    },
    "payment_date": {
      "type": "string",
      "title": "Date du paiement",
      "format": "date"
    },
    "method": {
      "type": "string",
      "title": "Moyen de paiement",
      "enum": [
        "Esp\u00e8ces",
        "Mobile money",
        "Virement",
        "Ch\u00e8que"
      ],
      "default": "Esp\u00e8ces"
    },
    "reference": {
      "type": "string",
      "title": "R\u00e9f\u00e9rence"
    },
    "receipt_number": {
      "type": "string",
      "title": "Num\u00e9ro de quittance"
    },
    "note": {
      "type": "string",
      "title": "Note"
    }
  },
  "required": [
    "due_id",
    "amount",
    "payment_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}