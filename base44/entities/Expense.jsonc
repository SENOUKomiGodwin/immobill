{
  "name": "Expense",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string",
      "title": "Bien"
    },
    "property_name": {
      "type": "string",
      "title": "Bien (nom)"
    },
    "label": {
      "type": "string",
      "title": "Libell\u00e9"
    },
    "category": {
      "type": "string",
      "title": "Cat\u00e9gorie",
      "enum": [
        "Plomberie",
        "Peinture",
        "\u00c9lectricit\u00e9",
        "Taxes",
        "Assurance",
        "Gardiennage",
        "R\u00e9paration",
        "Autre"
      ],
      "default": "Autre"
    },
    "vendor": {
      "type": "string",
      "title": "Prestataire"
    },
    "amount": {
      "type": "number",
      "title": "Montant (FCFA)"
    },
    "expense_date": {
      "type": "string",
      "title": "Date",
      "format": "date"
    },
    "paid": {
      "type": "boolean",
      "title": "Pay\u00e9e",
      "default": true
    },
    "refacture": {
      "type": "boolean",
      "title": "Refactur\u00e9e au locataire",
      "default": false
    },
    "recovered_amount": {
      "type": "number",
      "title": "Montant r\u00e9cup\u00e9r\u00e9 (FCFA)",
      "default": 0
    },
    "receipt_uri": {
      "type": "string",
      "title": "Justificatif"
    },
    "note": {
      "type": "string",
      "title": "Note"
    }
  },
  "required": [
    "label",
    "amount",
    "expense_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}