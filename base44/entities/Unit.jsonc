{
  "name": "Unit",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string",
      "title": "Bien"
    },
    "label": {
      "type": "string",
      "title": "Nom de l'unit\u00e9"
    },
    "type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "Appartement",
        "Studio",
        "Chambre",
        "Boutique",
        "Autre"
      ],
      "default": "Appartement"
    },
    "surface": {
      "type": "number",
      "title": "Surface (m\u00b2)"
    },
    "rent_amount": {
      "type": "number",
      "title": "Loyer mensuel (FCFA)"
    },
    "charges_amount": {
      "type": "number",
      "title": "Charges mensuelles (FCFA)"
    },
    "status": {
      "type": "string",
      "title": "Statut",
      "enum": [
        "Libre",
        "Occup\u00e9"
      ],
      "default": "Libre"
    }
  },
  "required": [
    "property_id",
    "label"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}